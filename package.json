{
  "name": "rust-lint-action",
  "version": "4.5.0",
  "private": true,
  "description": "GitHub Action for detecting and fixing linting errors for rust",
  "license": "MIT",
  "repository": "github:wearerequired/lint-action",
  "main": "./dist/index.js",
  "scripts": {
    "build": "vite build",
    "format": "oxfmt",
    "type-check": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "test:watch": "vitest --project unit --project integration"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@octokit/core": "^7.0.6",
    "command-exists": "^1.2.9",
    "parse-diff": "^0.12.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "2.57.0",
    "@types/command-exists": "1.2.3",
    "@types/node": "25.9.9",
    "@vitest/coverage-v8": "5.0.5",
    "openapi-format": "1.33.7",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
